 <HI REND="ITALIC">Belimensis,</HI>  et  <HI REND="ITALIC">Balmiensis.</HI></NOTE> 
 <HI REND="ITALIC">episcopus subscripsi. Perseverantius Tebertinus</HI> <NOTE N="21" TYPE="foot" ANCHORED=Y COM="0381" BLOCK="NO"><COL N="0381"></COL> Mss. plerique loco,  <HI REND="ITALIC">Perseverantius,</HI>  habent,  <HI REND="ITALIC">Perserentius.</HI> 
