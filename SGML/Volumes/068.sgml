 <AUTHOR>S. AURELIANUS ARELATENSIS,</AUTHOR>  
 <AUTHOR>PRIMASIUS,</AUTHOR>  
 <AUTHOR>VICTOR TUNONENSIS,</AUTHOR>  
 <AUTHOR>LIBERATUS DIACONUS.</AUTHOR>  

 <AUTH.NO>TOMUS UNICUS. </AUTH.NO> 

 <IMPRINT>EXCUDEBATUR ET VENIT APUD EDITOREM,
IN VIA DICTA  <HI REND="ITALIC">D'AMBOISE,</HI>  PROPE PORTAM LUTETIAE PARISIORUM VULGO  <HI REND="ITALIC">D'ENFER</HI>  NOMINATAM,
SEU PETIT-MONTROUGE.</IMPRINT>  

