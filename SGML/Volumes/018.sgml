officiumque indicans.  <HI REND="ITALIC">Interpr.</HI></NOTE></C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">skulum</HI></C> <C N=4 INDENT=360 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">skulda</HI></C> <C N=5 INDENT=475 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">skulds</HI></C> <C N=6 INDENT=590 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">skulan</HI></C></R> <R><C N=1 INDENT=15 WIDTH=100 ALIGN="LEFT">3 absonantiae classis</C> <C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">7.  <HI REND="ITALIC">nah</HI>  necesse est</C> <C N=4 INDENT=360 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">nauhta</HI></C> <C N=5 INDENT=475 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">nauhts</HI></C> <C N=6 INDENT=590 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">nauhan</HI></C></R> <R><C N=1 INDENT=15 WIDTH=100 ALIGN="LEFT">4 absonantiae classis</C> <C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">8.  <HI REND="ITALIC">vait</HI>  scio</C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">vitum</HI></C> <C N=4 INDENT=360 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">vissa</HI></C> <C N=5 INDENT=475 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">vits?</HI></C> <C N=6 INDENT=590 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">vitan</HI></C></R> <R><C N=1 INDENT=15 WIDTH=100 ALIGN="LEFT">absonantiae classis</C> <C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">9.  <HI REND="ITALIC">aih</HI>  habeo</C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">aigum</HI></C> <C N=4 INDENT=360 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">aihta</HI></C> <C N=5 INDENT=475 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">aihts</HI></C> <C N=6 INDENT=590 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">aigan</HI></C></R> <R><C N=1 INDENT=15 WIDTH=100 ALIGN="LEFT">5 absonantiae classis</C> <C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">10.  <HI REND="ITALIC">daug</HI>  consto</C> <C N=4 INDENT=360 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">dauhta</HI></C> <C N=5 INDENT=475 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">dauhts</HI></C> <C N=6 INDENT=590 WIDTH=100 ALIGN="L