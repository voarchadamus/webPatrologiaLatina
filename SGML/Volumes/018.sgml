ticipium.</CAPTION> <P COM="0986">Act.  <HI REND="ITALIC">steigands</HI>  Pass.  <HI REND="ITALIC">stigans</HI></P> <P COM="0986">Sic conjugantur;  <HI REND="ITALIC">deigan</HI>  formare,  <HI REND="ITALIC">veigan</HI>  pugnare,
 <HI REND="ITALIC">þeihan</HI>  proficere,  <HI REND="ITALIC">þreihan</HI>  angustare,  <HI REND="ITALIC">gateihan</HI>  praedicare,
 <HI REND="ITALIC">beidan</HI>  exspectare,  <HI REND="ITALIC">leiþan</HI>  ire,  <HI REND="ITALIC">sneiþan</HI>  metere,
 <HI REND="ITALIC">beitan</HI>  mordere,  <HI REND="ITALIC">skreitan,</HI>  scindere,  <HI REND="ITALIC">smeitan</HI>  ungere,
 <HI REND="ITALIC">veitan</HI>  videre,  <HI REND="ITALIC">urreisan</HI>  surgere,  <HI REND="ITALIC">leisan</HI>  discere,  <HI REND="ITALIC">dreiban</HI> 
pellere,  <HI REND="ITALIC">sveiban</HI>  cessare,  <HI REND="ITALIC">greipan</HI>  prehendere,  <HI REND="ITALIC">veipan</HI> 
 <COL N="0987"></COL> coronare,  <HI REND="ITALIC">hneivan</HI>  declinare,  <HI REND="ITALIC">speivan</HI>  spuere,  <HI REND="ITALIC">leiwan</HI> 
mutuari,  <HI REND="ITALIC">keian</HI>  germinare,  <HI REND="ITALIC">skeinan</HI>  splendere.</P> <CAPTION COM="0987">§ 122. 5.  <HI REND="ITALIC">Driusan</HI>  cadere.</CAPTION> <TBL COL="03" WIDTH1=10 WIDTH2=10 WIDTH3=10 COM="0987"><HEAD COM="0987">Indicativus.</HEAD> <HR><H N=2 INDENT=130 WIDTH=100 ALIGN="CENTRE">Praesens.</H> <H N=3 INDENT=245 WIDTH=100 ALIGN="CENTRE">Praeteritum.</H></HR> <R><C N=1 INDENT=15 WIDTH=100 ALIGN="LEFT">Sing.</C> <C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">1  <HI REND="ITALIC">driusa</HI></C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">draus</HI></C></R> <R><C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">2  <HI REND="ITALIC">driusis</HI></C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">draust</HI></C></R> <R><C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">3  <HI REND="ITALIC">driusiþ</HI></C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">draus</HI></C></R> <R><C N=1 INDENT=15 WIDTH=100 ALIGN="LEFT">Dual.</C> <C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">1  <HI REND="ITALIC">driusos</HI></C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">drusu</HI></C></R> <R><C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">2  <HI REND="ITALIC">driusats</HI></C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">drusuts</HI></C></R> <R><C N=1 INDENT=15 WIDTH=100 ALIGN="LEFT">Plur.</C> <C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">1  <HI REND="ITALIC">driusam</HI></C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">drusum</HI></C></R> <R><C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">2  <HI REND="ITALIC">driusiþ</HI></C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">drusuþ</HI></C></R> <R><C N=2 INDENT=130 WIDTH=100 ALIGN="LEFT">3  <HI REND="ITALIC">driusand</HI></C> <C N=3 INDENT=245 WIDTH=100 ALIGN="LEFT"><HI REND="ITALIC">drusun</HI></C></R></TBL> <TBL COL="03" WIDTH1=10 WIDTH2=10 WIDTH3=10 COM="0987"><HEAD COM="0987">Conjunctivus.</HEAD> <R><C N=1 INDENT=15 WIDTH=100 ALIGN="LEFT">Sing.</C> <C N=2 INDENT