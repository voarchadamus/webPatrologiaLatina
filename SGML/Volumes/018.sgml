 <FOREIGN LANG=Greek>Galilaiva,</FOREIGN>   <HI REND="ITALIC">taleiþa</HI>   <FOREIGN LANG=Greek>Taliqav,</FOREIGN>   <HI REND="ITALIC">teimaius</HI>   <FOREIGN LANG=Greek>Timaiðoû,</FOREIGN>   <HI REND="ITALIC">teimauþaius</HI> 
 <FOREIGN LANG=Greek>Timovqeoû,</FOREIGN>   <HI REND="ITALIC">þaiaufeilus</HI>   <FOREIGN LANG=Greek>Qeovfiloû,</FOREIGN>   <HI REND="ITALIC">iaireiko</HI>   <CITN>( <HI REND="ITALIC">eiaireiko</HI> 
Esdr. II, 34)</CITN>   <FOREIGN LANG=Greek>2Iericwv,</FOREIGN>   <HI REND="ITALIC">tykeikus</HI>   <FOREIGN LANG=Greek>Tucikovû,</FOREIGN>   <HI REND="ITALIC">teibairius</HI> 
 <FOREIGN LANG=Greek>Tibevrioû.</FOREIGN></P> <P COM="0924">«Annotatio 1.—Quandoque etiam ponitur pro  <FOREIGN LANG=Greek>h</FOREIGN> 
