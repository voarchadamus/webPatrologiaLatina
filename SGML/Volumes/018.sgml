circumdare,  <HI REND="ITALIC">faurvaipjan</HI>  ligare,  <HI REND="ITALIC">arbaidjan</HI>  laborare,
 <HI REND="ITALIC">baidjan</HI>  cogere,  <HI REND="ITALIC">usbraidjan</HI>  dilatare,  <HI REND="ITALIC">maidjan</HI> 
corrumpere,  <HI REND="ITALIC">raidjan</HI>  constituere,  <HI REND="ITALIC">ganaitjan</HI>  improbare,
 <HI REND="ITALIC">usgaisjan</HI>  pavescere,  <HI REND="ITALIC">laisjan</HI>  docere,  <HI REND="ITALIC">raisjan</HI>  excitare,
 <HI REND="ITALIC">laistjan</HI>  sequi;</P> <P COM="0991"><HI REND="ITALIC">ee) ufbauljan</HI>  inflare,  <HI REND="ITALIC">bisauljan</HI>  maculare,  <HI REND="ITALIC">gaumjan</HI> 
videre,  <HI REND="ITALIC">haunjan</HI>  humiliare,  <HI REND="ITALIC">gaurjan</HI>  contristari,
 <HI REND="ITALIC">kaurjan</HI>  gravare,  <HI REND="ITALIC">augjan</HI>  ostendere,  <HI REND="ITALIC">usbaugjan</HI>  everrere,
 <HI REND="ITALIC">laugnjan</HI>  negare,  <HI REND="ITALIC">hauhjan</HI>  extollere,  <HI REND="ITALIC">gadaubjan</HI> 
