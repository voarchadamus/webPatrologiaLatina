 <HI REND="ITALIC">hoha</HI>  aratrum,  <HI REND="ITALIC">uzeta</HI>  praesepe,  <HI REND="ITALIC">galaista</HI>  comes,
 <HI REND="ITALIC">manleika</HI>  imago,  <HI REND="ITALIC">galeika</HI>  concorporale,  <HI REND="ITALIC">usliþa</HI>  paralyticus,
 <HI REND="ITALIC">liuta</HI>  hypocrita,  <HI REND="ITALIC">lofa</HI>  manus arida,  <HI REND="ITALIC">magula</HI> 
parvulus,  <HI REND="ITALIC">maimbrana</HI>  pergamen,  <HI REND="ITALIC">malma</HI>  arena,  <HI REND="ITALIC">mela</HI> 
modius,  <HI REND="ITALIC">mena</HI>  luna,  <HI REND="ITALIC">milhma</HI>  populus,  <HI REND="ITALIC">ganauha</HI>  sufficientia,
