et S. BEATUS presbyter.</GL.TERM> <GL.GLOSS>859</GL.GLOSS> <GL.TERM>RACHIO, Argentinensis episcopus.</GL.TERM> <GL.GLOSS>1029</GL.GLOSS> <GL.TERM>ANGELRAMNUS, Metensis episcopus.</GL.TERM> <GL.GLOSS>1033</GL.GLOSS> <GL.TERM>WICBODUS.</GL.TERM> <GL.GLOSS>1101</GL.GLOSS> <GL.TERM>ADRIANUS papa I.</GL.TERM> <GL.GLOSS>1203</GL.GLOSS></LIST.GL> <LIST.GL><HEAD>SAECULI VIII AUCTORES INCERTI</HEAD> <GL.TERM>ISIDORUS Pacensis.</GL.TERM> <GL.GLOSS>1251</GL.GLOSS> <GL.TERM>ABEDOC et ETHELVOLFUS, abbates Hiberni.</GL.TERM> <GL.GLOSS>1281</GL.GLOSS> <GL.TERM>MARCUS, Idrontinus episcopus.</GL.TERM> <GL.GLOSS>1345</GL.GLOSS> <GL.TERM>PETRUS archidiaconus.</GL.TERM> <GL.GLOSS>1347</GL.GLOSS> <GL.TERM>CATULFUS.</GL.TERM> <GL.GLOSS>1363</GL.GLOSS> <GL.TERM>CONSTANS sacerdos.</GL.TERM> <GL.GLOSS>1367</GL.GLOSS> <GL.TERM>GARNERIUS abbas.</GL.TERM> <GL.GLOSS>1369</GL.GLOSS> <GL.TERM>ANONYMI SAECULI VIII.</GL.TERM> <GL.GLOSS>1373</GL.GLOSS> <GL.TERM>SAECULI VIII MONUMENTA ECCLESIASTICA.</GL.TERM> <GL.GLOSS>1481</GL.GLOSS> <GL.TERM>PIPPINI, CAROLOMANNI ET ALIORUM INTER ILLUSTRIORES
