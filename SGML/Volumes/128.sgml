ANNO CHRISTI 336, CONSTANTINI IMP. 31.</HEAD> <NOTE TYPE="Variae Lectiones" ANCHORED=N BLOCK=YES COM="0009"><COL N="0009A"></COL> <CAPTION COM="0009"><HI REND="ITALIC">Apud Fabrottum extra marginem ex cod Freheri,</HI> A  <HI REND="ITALIC">primo,</HI>  B  <HI REND="ITALIC">secundo.</HI></CAPTION> 

