 <CAPTION COM="0230"><COL N="0230C"></COL> <HI REND="ITALIC">Apud Peniam ex codice Cavensi.</HI></CAPTION> 

 <P COM="0230"><HI REND="ITALIC">Num 63. lin</HI>  1, Xystus tertius.  <HI REND="ITALIC">linea ead</HI>  Xysto.  <HI REND="ITALIC">lin</HI>  5,
