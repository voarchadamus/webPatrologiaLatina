Asa</GL.TERM> <GL.GLOSS>41</GL.GLOSS> <GL.TERM>Josaphat</GL.TERM> <GL.GLOSS>25</GL.GLOSS> <GL.TERM>Joram</GL.TERM> <GL.GLOSS>8</GL.GLOSS> <GL.TERM>Ochozias</GL.TERM> <GL.GLOSS>1</GL.GLOSS> <GL.TERM>Godolias</GL.TERM> <GL.GLOSS>8</GL.GLOSS> <GL.TERM>Joas</GL.TERM> <GL.GLOSS>40</GL.GLOSS> <GL.TERM><COL N="0965D"></COL> Amasias</GL.TERM> <GL.GLOSS>29</GL.GLOSS> <GL.TERM>Ozias</GL.TERM> <GL.GLOSS>52</GL.GLOSS> <GL.TERM>Joathas</GL.TERM> <GL.GLOSS>16</GL.GLOSS> <GL.TERM>Achas</GL.TERM> <GL.GLOSS>16</GL.GLOSS> <GL.TERM>Ezechias</GL.TERM> <GL.GLOSS>29</GL.GLOSS> <GL.TERM>Manasses</GL.TERM> <GL.GLOSS>55</GL.GLOSS> <GL.TERM>Amon</GL.TERM> <GL.GLOSS>2</GL.GLOSS> <GL.TERM>Josias</GL.TERM> <GL.GLOSS>31</GL.GLOSS> <GL.TERM>Joachaz</GL.TERM> <GL.GLOSS>0 1/4</GL.GLOSS> <GL.TERM>Joachim</GL.TERM> <GL.GLOSS>11</GL.GLOSS> <GL.TERM>Jechonias</GL.TERM> <GL.GLOSS>0 1/4</GL.GLOSS> <GL.TERM></GL.TERM> <GL.GLOSS>505</GL.GLOSS> <CAPTION COM="0965"><COL N="0966C"></COL> <HI REND="ITALIC">Restauratio templi.</HI></CAPTION> <GL.TERM>Nomen Adae</GL.TERM> <GL.GLOSS><FOREIGN LANG=Greek>a</FOREIGN>  1</GL.GLOSS> <GL.TERM></GL.TERM> <GL.GLOSS><FOREIGN LANG=Greek>d</FOREIGN>  4</GL.GLOSS> <GL.TERM></GL.TERM> <GL.GLOSS><FOREIGN LANG=Greek>a</FOREIGN>  1</GL.GLOSS> <GL.TERM></GL.TERM> <GL.GLOSS><FOREIGN LANG=Greek>m</FOREIGN>  40</GL.GLOSS> <GL.TERM></GL.TERM> <GL.GLOSS>46</GL.GLOSS> <CAPTION COM="0966"><HI REND="ITALIC">Septem hebdomades.</HI></CAPTION> <GL.TERM>Cyrus</GL.TERM> <GL.GLOSS>31</GL.GLOSS> <GL.TERM>Cambyses</GL.TERM> <GL.GLOSS>9</GL.GLOSS> <GL.TERM><COL N="0966D"></COL> Smerdis</GL.TERM> <GL.GLOSS>0</GL.GLOSS> <GL.TERM>Darius (II et IV)</GL.TERM> <GL.GLOSS>6</GL.GLOSS> <GL.TERM>Restauratio templi</GL.TERM> <GL.GLOSS>46</GL.GLOSS> <GL.TERM>Mysterium passionis</GL.TERM> <GL.GLOSS>3</GL.GLOSS> <GL.TERM></GL.TERM> <GL.GLOSS>49</GL.GLOSS> <GL.TERM>C. Centenarius triplicatus, CCC.</GL.TERM> <GL.GLOSS>300  <FOREIGN LANG=Greek>t</FOREIGN>  signum crucis</GL.GLOSS> <GL.TERM>Reliqui XVIII</GL.TERM>